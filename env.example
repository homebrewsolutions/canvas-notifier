# Canvas
CANVAS_URL=https://howard.instructure.com
CANVAS_TOKEN=your_canvas_api_token_here

# CallMeBot (WhatsApp send-only) — optional, users can register via the web UI
# 1. Add +34 644 59 82 46 on WhatsApp and send: "I allow callmebot to send me messages"
# 2. You'll receive your API key via WhatsApp — paste it in the /setup/phone page
# Set these as fallback defaults (e.g. for daily_digest.py cron runs)
CALLMEBOT_API_KEY=
YOUR_PHONE_NUMBER=+1

# Anthropic
ANTHROPIC_API_KEY=

# App
FLASK_SECRET_KEY=pick_any_random_string_here
DAYS_AHEAD=14
